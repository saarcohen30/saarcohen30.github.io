---
import Base from '../../layouts/Base.astro';
import PubItem from '../../components/pubs/PubItem.astro';
import TypeBadge from '../../components/pubs/TypeBadge.astro';
import Icon from '../../components/Icon.astro';
import { profile, publications, groupByYear, yearsOf, typeCounts, SITE_URL } from '../../lib/site';

const working = publications.filter((p) => p.isWorkingPaper);
const review = publications.filter((p) => p.isUnderReview);
const accepted = publications.filter((p) => p.isAccepted);
const years = groupByYear(publications);
const types = typeCounts(publications);
const yearList = yearsOf(publications);
const publishedCount = accepted.length;
const toAppear = accepted.filter((p) => p.status === 'to-appear').length;
const scholar = profile.links.find((l: { kind: string }) => l.kind === 'scholar');

const description = `All ${publications.length} papers by ${profile.name}: ${publishedCount} published or accepted (${yearList.at(-1)}–${yearList[0]}), ${working.length} working papers and ${review.length} under review, on game theory, computational social choice, fair division, multi-agent learning and AI safety. Filter by type and year; copy BibTeX.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Publications · ${profile.name}`,
  url: `${SITE_URL}/publications/`,
  author: { '@id': `${SITE_URL}/#person` },
  hasPart: accepted
    .map((p) => ({ '@type': 'ScholarlyArticle', headline: p.title, url: `${SITE_URL}/publications/${p.id}/`, datePublished: String(p.year) })),
};
---

<Base title="Publications" description={description} jsonLd={jsonLd}>
  <div class="wrap page-head">
    <p class="eyebrow">Research output</p>
    <h1>Publications</h1>
    <p class="summary">
      <span class="mono">{publishedCount}</span> published and accepted papers from {yearList.at(-1)} to {yearList[0]}{toAppear > 0 && ` (${toAppear} to appear)`},{' '}
      <span class="mono">{working.length}</span> working papers and <span class="mono">{review.length}</span> under review. Each paper has its own page with the abstract, all versions and a citation.
    </p>
    <p class="head-links">
      {
        scholar && (
          <a href={scholar.url} class="btn">
            <Icon name="scholar" /> Google Scholar
          </a>
        )
      }
      <a href="/publications.bib" class="btn" download>
        <Icon name="download" /> All BibTeX <span class="visually-hidden">(.bib file)</span>
      </a>
    </p>
  </div>

  <div class="wrap layout">
    <aside class="filters-col" aria-label="Filters">
      <form class="filters js-only" role="search" data-filters onsubmit="return false">
        <div class="search">
          <label for="pub-q" class="visually-hidden">Search publications</label>
          <Icon name="search" size={17} />
          <input id="pub-q" type="search" name="q" placeholder="Search papers…" autocomplete="off" spellcheck="false" data-q />
          <kbd aria-hidden="true">/</kbd>
        </div>

        <fieldset class="facet">
          <legend class="eyebrow">Type</legend>
          <div class="chips" data-facet="type">
            {
              types.map((t) => (
                <button type="button" class="fchip" aria-pressed="false" data-value={t.type}>
                  <TypeBadge type={t.type as any} />
                  <span class="count mono" data-count>
                    {t.count}
                  </span>
                </button>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="facet">
          <legend class="eyebrow">Year</legend>
          <div class="chips years" data-facet="year">
            {
              yearList.map((y) => (
                <button type="button" class="fchip year" aria-pressed="false" data-value={y}>
                  <span class="mono">{y}</span>
                  <span class="count mono" data-count />
                </button>
              ))
            }
          </div>
        </fieldset>
      </form>
    </aside>

    <div class="results">
      <div class="status-bar js-only">
        <p class="status mono" data-status aria-live="polite">Showing all {publications.length} papers</p>
        <button type="button" class="clear mono" data-clear hidden><Icon name="x" size={14} /> Clear filters</button>
      </div>

      {
        working.length > 0 && (
          <section class="group" aria-labelledby="wp-h" data-group>
            <header class="group-head">
              <h2 id="wp-h">Working papers</h2>
              <p class="group-note">Public preprints, not yet under review or accepted.</p>
            </header>
            <div class="items">
              {working.map((p) => (
                <PubItem pub={p} level={3} />
              ))}
            </div>
          </section>
        )
      }

      {
        review.length > 0 && (
          <section class="group" aria-labelledby="ur-h" data-group>
            <header class="group-head">
              <h2 id="ur-h">Under review</h2>
              <p class="group-note">Submitted work; details appear here once it is public.</p>
            </header>
            <div class="items">
              {review.map((p) => (
                <PubItem pub={p} level={3} />
              ))}
            </div>
          </section>
        )
      }

      <section class="group" aria-labelledby="pub-h" data-group>
        <header class="group-head">
          <h2 id="pub-h">Publications</h2>
          <p class="group-note">Published and accepted, newest first.</p>
        </header>
        {
          years.map(({ year, items }) => (
            <div class="year-block" data-year-group={year}>
              <h3 class="year mono" id={`y${year}`}>
                {year}
              </h3>
              <div class="items">
                {items.map((p) => (
                  <PubItem pub={p} level={4} />
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <div class="empty" data-empty hidden>
        <svg viewBox="0 0 64 40" width="64" height="40" aria-hidden="true">
          <circle cx="12" cy="20" r="4" fill="none" stroke="currentColor" stroke-dasharray="2 2" />
          <path d="M20 20h24" stroke="currentColor" stroke-dasharray="2 4" />
          <circle cx="52" cy="20" r="4" fill="currentColor" opacity=".35" />
        </svg>
        <p>No papers match these filters.</p>
        <button type="button" class="btn" data-clear>Clear filters</button>
      </div>
    </div>
  </div>

  <a href="#main" class="to-filters mono js-only" data-to-filters hidden>
    <Icon name="search" size={15} /> Filters <span class="n" data-active-n></span>
  </a>
</Base>

<script>
  import '../../scripts/pub-filters';
</script>

<style>
  .page-head {
    padding-block: var(--space-7) var(--space-6);
    display: grid;
    gap: var(--space-3);
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 330;
    letter-spacing: -0.035em;
    line-height: 1;
    font-variation-settings: 'opsz' 72;
  }
  .summary {
    max-width: 58ch;
    color: var(--ink-2);
    font-size: var(--step-0);
  }
  .summary .mono {
    color: var(--ink);
  }
  .head-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-2);
  }

  .layout {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 15.5rem minmax(0, 1fr);
      gap: var(--space-7);
    }
    .filters {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      max-height: calc(100svh - var(--header-h) - 3rem);
      overflow: auto;
      padding-right: 0.25rem;
    }
  }

  .filters {
    display: grid;
    gap: var(--space-5);
  }
  .search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search :global(svg) {
    position: absolute;
    left: 0.8rem;
    color: var(--ink-3);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    min-height: 2.9rem;
    padding: 0.5rem 2.4rem 0.5rem 2.45rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--bg-elev);
    font-family: var(--font-mono);
    font-size: max(16px, var(--step--1)); /* ≥16px avoids iOS zoom on focus */
    transition:
      border-color var(--dur-1),
      box-shadow var(--dur-1);
  }
  .search input::placeholder {
    color: var(--ink-3);
    opacity: 1;
  }
  .search input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 22%, transparent);
  }
  .search input::-webkit-search-cancel-button {
    display: none;
  }
  kbd {
    position: absolute;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border: 1px solid var(--line-2);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
  }
  .search input:focus ~ kbd,
  .search input:not(:placeholder-shown) ~ kbd {
    display: none;
  }
  @media (pointer: coarse) {
    kbd {
      display: none;
    }
  }

  .facet {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .facet legend {
    margin-bottom: var(--space-3);
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  @media (min-width: 960px) {
    .chips:not(.years) {
      display: grid;
    }
    .chips.years {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
    .fchip.year {
      padding-inline: 0.7rem 0.6rem;
    }
  }
  /* Phones: one scrollable row per facet rather than a tall wall of chips. */
  @media (max-width: 959px) {
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      mask-image: linear-gradient(to right, transparent, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent);
    }
    .chips::-webkit-scrollbar {
      display: none;
    }
    .fchip {
      flex: none;
    }
  }
  .fchip {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-height: 2.6rem;
    padding: 0.3rem 0.7rem 0.3rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    text-align: left;
    transition:
      border-color var(--dur-1),
      background-color var(--dur-1),
      opacity var(--dur-2);
  }
  .fchip.year {
    min-height: 2.4rem;
    padding-inline: 0.85rem 0.75rem;
    font-size: var(--step--1);
    line-height: 1;
  }
  .fchip:hover {
    border-color: var(--ink-3);
  }
  .fchip[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--bg-elev);
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  /* No matches with the current filters: still readable (contrast), visibly "empty". */
  .fchip[data-zero]:not([aria-pressed='true']) {
    border-style: dashed;
    background: transparent;
  }
  .count {
    font-size: var(--step--2);
    color: var(--ink-3);
    min-width: 1.2em;
    text-align: right;
  }
  .count:empty {
    display: none;
  }

  .status-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 2.75rem;
    padding-bottom: var(--space-3);
  }
  .status {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .status :global(b) {
    color: var(--ink);
    font-weight: 600;
  }
  .clear {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.5rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 9%, transparent);
  }
  .clear:hover {
    background: color-mix(in oklab, var(--accent) 16%, transparent);
  }

  .group + .group {
    margin-top: var(--space-7);
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
    padding-bottom: var(--space-3);
  }
  .group-head h2 {
    font-size: var(--step-2);
  }
  .group-note {
    font-size: var(--step--1);
    color: var(--ink-3);
    font-style: italic;
  }
  .items {
    border-bottom: 1px solid var(--line);
  }
  .items :global(.title) {
    max-width: 58ch;
  }

  .year-block {
    display: grid;
  }
  .year {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    padding: 0.6rem 0 0.5rem;
    background: var(--bg);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }
  @media (min-width: 1200px) {
    .year-block {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
    .year {
      top: calc(var(--header-h) + 1.2rem);
      align-self: start;
      padding-top: 1.35rem;
      background: none;
      font-size: var(--step-1);
      font-weight: 400;
      color: var(--ink-3);
    }
    .year-block + .year-block .items {
      border-top: 0;
    }
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-4);
    text-align: center;
    color: var(--ink-3);
  }

  .to-filters {
    position: fixed;
    right: var(--gutter);
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.9rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--step--1);
    text-decoration: none;
    box-shadow: var(--shadow);
    animation: pill-in 300ms var(--ease-out);
  }
  .to-filters .n:not(:empty) {
    display: grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding-inline: 0.3rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.72rem;
  }
  @keyframes pill-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (min-width: 960px) {
    .to-filters {
      display: none !important;
    }
  }
  :global(html:not(.js)) .js-only {
    display: none !important;
  }
</style>
