---
// Hidden review page for site-mark candidates (not linked, not in the sitemap, noindex).
import Base from '../../layouts/Base.astro';
import LogoA from '../../components/logos/LogoA.astro';
import LogoB from '../../components/logos/LogoB.astro';
import LogoC from '../../components/logos/LogoC.astro';
import LogoB1 from '../../components/logos/LogoB1.astro';
import LogoB2 from '../../components/logos/LogoB2.astro';
import LogoB3 from '../../components/logos/LogoB3.astro';
import LogoB4 from '../../components/logos/LogoB4.astro';
import Mark from '../../components/Mark.astro';

const candidates = [
  { key: 'B1', name: 'Two currents', note: 'Two currents in complementary motion: one rises and runs on, the other falls and returns. They part around a tilted central void and settle level at both ends, so the balance comes from negative space and controlled asymmetry, not from a symbol.', C: LogoB1 },
  { key: 'B2', name: 'One stroke', note: 'A single calligraphic stroke: heavy through the crest like a wave, thinning into a long glide like moving air. The most minimal; at 16 px it reads mostly as the crest.', C: LogoB2 },
  { key: 'B3', name: 'Negative-space current', note: 'A current cut through a solid tile splits it into two interlocking forms of equal weight; the flow is the empty channel between them. The strongest favicon of the four.', C: LogoB3 },
  { key: 'B4', name: 'S and C through flow', note: 'One stroke descends as an S and carries on into the lower arc of a C; the C’s upper arc curls back above it. The initials are there if you look, but it reads first as a current.', C: LogoB4 },
];
const earlier = [
  { key: 'B', name: 'Flow & balance (first version)', note: 'The earlier wave with a point in its trough, kept for comparison.', C: LogoB },
  { key: 'A', name: 'Monogram', note: 'Not selected.', C: LogoA },
  { key: 'C', name: 'Typographic', note: 'Not selected.', C: LogoC },
];
const sizes = [48, 32, 24, 16];
const surfaces = [
  { key: 'light', label: 'Light', style: '--s-bg:#f4f2ec;--s-ink:#14161b;--logo-accent:#2742c4;--logo-on:#f4f2ec' },
  { key: 'dark', label: 'Dark', style: '--s-bg:#0b0d11;--s-ink:#ebe8e1;--logo-accent:#93b0ff;--logo-on:#0b0d11' },
  { key: 'mono-l', label: 'Mono on light', style: '--s-bg:#ffffff;--s-ink:#000000;--logo-accent:#000000;--logo-on:#ffffff' },
  { key: 'mono-d', label: 'Mono on dark', style: '--s-bg:#000000;--s-ink:#ffffff;--logo-accent:#ffffff;--logo-on:#000000' },
];
---

<Base title="Logo candidates" description="Site-mark candidates for review." noindex>
  <div class="wrap review">
    <p class="eyebrow">Design review · not linked from the site</p>
    <h1>Site mark: Flow &amp; balance</h1>
    <p class="intro">Four marks in the Flow &amp; balance direction, none with a decorative point, shown at header size and at 48, 32, 24 and 16 px on light, dark and monochrome surfaces. Earlier candidates and the current mark follow for comparison. Nothing here replaces the live mark until you choose.</p>

    {
      candidates.map(({ key, name, note, C }) => (
        <section class="cand">
          <header>
            <h2>
              <span class="k">{key}</span> {name}
            </h2>
            <p>{note}</p>
          </header>
          <div class="grid">
            {surfaces.map((s) => (
              <div class="surface" style={s.style}>
                <p class="slabel">{s.label}</p>
                <div class="header-demo">
                  <C size={26} />
                  <span>Saar Cohen</span>
                </div>
                <div class="sizes">
                  {sizes.map((z) => (
                    <figure>
                      <C size={z} />
                      <figcaption>{z}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <h2 class="group">Earlier candidates (for comparison)</h2>
    {
      earlier.map(({ key, name, note, C }) => (
        <section class="cand">
          <header>
            <h2>
              <span class="k">{key}</span> {name}
            </h2>
            <p>{note}</p>
          </header>
          <div class="grid">
            {surfaces.map((s) => (
              <div class="surface" style={s.style}>
                <p class="slabel">{s.label}</p>
                <div class="header-demo">
                  <C size={26} />
                  <span>Saar Cohen</span>
                </div>
                <div class="sizes">
                  {sizes.map((z) => (
                    <figure>
                      <C size={z} />
                      <figcaption>{z}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <section class="cand">
      <header>
        <h2><span class="k">·</span> Current mark (for comparison)</h2>
      </header>
      <div class="grid">
        {
          surfaces.map((s) => (
            <div class="surface" style={s.style}>
              <p class="slabel">{s.label}</p>
              <div class="header-demo">
                <Mark size={26} />
                <span>Saar Cohen</span>
              </div>
              <div class="sizes">
                {sizes.map((z) => (
                  <figure>
                    <Mark size={z} />
                    <figcaption>{z}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .review {
    padding-top: var(--space-7);
    display: grid;
    gap: var(--space-6);
  }
  h1 {
    font-size: var(--step-3);
  }
  .intro {
    color: var(--ink-2);
    max-width: 64ch;
  }
  .group {
    font-size: var(--step-1);
    color: var(--ink-2);
    margin-top: var(--space-6);
  }
  .cand header {
    margin-bottom: var(--space-4);
  }
  .cand h2 {
    font-size: var(--step-2);
  }
  .cand header p {
    color: var(--ink-2);
    max-width: 70ch;
    font-size: var(--step--1);
  }
  .k {
    font-family: var(--font-mono);
    color: var(--accent);
    margin-right: 0.4em;
  }
  .grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--line);
  }
  .surface {
    background: var(--s-bg);
    color: var(--s-ink);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .slabel {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    opacity: 0.6;
  }
  .header-demo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.12rem;
  }
  .sizes {
    display: flex;
    align-items: flex-end;
    gap: 1.2rem;
  }
  figure {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    opacity: 0.55;
  }
</style>
