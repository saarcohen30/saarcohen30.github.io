---
// Hidden art-direction review for the elemental scenes (not linked, not in the sitemap, noindex).
// Only "Earth D" is the live scene; everything else here is a study for review.
import Base from '../../layouts/Base.astro';
import { ENTRIES, type Entry, type Group } from '../../lib/field/review/registry';

const group = (g: Group) => ENTRIES.filter((e) => e.group === g);
const FRAMES = [
  { at: 1200, label: 'early 1.2 s' },
  { at: 2800, label: 'middle 2.8 s' },
  { at: 4800, label: 'late 4.8 s' },
  { at: -1, label: 'live' },
];
const sections = [
  { id: 'approved', title: 'Approved', intro: 'The live Water and Air scenes, unchanged.', items: group('approved'), open: true },
  { id: 'earth', title: 'Selected for production', intro: 'Earth D, the Dune Field, is now the live Earth scene (?scene=earth). Elemental scenes stay out of the normal rotation.', items: group('earth'), open: true },
  {
    id: 'fire',
    title: 'New Fire studies',
    intro: 'Fire with choreography: gather, ignition, travel, release, settling. Each card shows early, middle, late and live frames below it; use Slow to watch the timing at a quarter speed.',
    items: group('fire-new'),
    open: true,
    frames: true,
  },
  { id: 'convergence', title: 'New Convergence studies', intro: 'Two executions of one night-lake world: a small island with a bonfire, its light on the island and in the water, wind, smoke and embers, all in one perspective.', items: group('conv-new'), open: true },
  { id: 'fire-old', title: 'Earlier rejected Fire studies', intro: 'A, B, C: kept for comparison only.', items: group('fire-old'), open: false },
  { id: 'conv-old', title: 'Earlier rejected Convergence studies', intro: 'A, B, C: kept for comparison only.', items: group('conv-old'), open: false },
  { id: 'earth-old', title: 'Other Earth studies (not selected)', intro: 'A, B, C: kept for reference.', items: group('earth-old'), open: false },
];
const stills = ['water', 'air', 'earth', 'conv-D', 'conv-E'];
const label = (id: string) => ENTRIES.find((e) => e.id === id)!.label;
const card = (e: Entry, frames = false) => ({ e, frames });
---

<Base title="Element concepts" description="Art-direction prototypes for the elemental scenes." noindex>
  <div class="wrap review">
    <p class="eyebrow">Design review · not linked from the site</p>
    <h1>Elemental scenes</h1>
    <p class="intro">
      Each card plays its entrance on load. <b>Replay</b> restarts it, <b>Pause</b> holds it, <b>Reset</b> jumps to the settled state, <b>Slow</b> plays at a quarter speed. Move the pointer over a card to try its pointer response. Studies are
      prototypes for choosing a direction; they are not tuned for phones.
    </p>
    <nav class="toc" aria-label="Sections">
      {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
      <a href="#stills">Still frames</a>
    </nav>

    {
      sections.map((s) => {
        const body = (
          <>
            <p class="intro">{s.intro}</p>
            <div class={`cards${s.frames ? ' wide' : ''}`}>
              {s.items.map((e) => {
                const c = card(e, !!s.frames);
                return (
                  <article class="card" data-card={c.e.id}>
                    <div class="stage">
                      <canvas aria-label={`${c.e.label}: ${c.e.title}`} role="img" />
                    </div>
                    <div class="ctl">
                      <span class="k">{c.e.label}</span>
                      <span class="t">{c.e.title}</span>
                      <span class="btns">
                        <button type="button" data-act="replay">Replay</button>
                        <button type="button" data-act="pause" aria-pressed="false">Pause</button>
                        <button type="button" data-act="reset">Reset</button>
                        <button type="button" data-act="slow" aria-pressed="false">Slow</button>
                      </span>
                    </div>
                    {c.frames && (
                      <div class="frames" data-frames={c.e.id}>
                        {FRAMES.map((fr) => (
                          <figure data-at={fr.at}>
                            <canvas aria-label={`${c.e.label} at ${fr.label}`} role="img" />
                            <figcaption>{fr.label}</figcaption>
                          </figure>
                        ))}
                      </div>
                    )}
                    <p class="note">{c.e.note}</p>
                  </article>
                );
              })}
            </div>
          </>
        );
        return s.open ? (
          <section id={s.id}>
            <h2>{s.title}</h2>
            {body}
          </section>
        ) : (
          <section id={s.id} class="secondary">
            <details data-lazy>
              <summary>
                <h2>{s.title}</h2>
              </summary>
              {body}
            </details>
          </section>
        );
      })
    }

    <section id="stills">
      <h2>Still frames</h2>
      <p class="intro">The approved and selected scenes and the new lake studies at the same moment (4.5 s after they start).</p>
      <div class="stills" data-stills>
        {
          stills.map((id) => (
            <figure data-still={id}>
              <canvas aria-label={label(id)} role="img" />
              <figcaption>{label(id)}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<script>
  import '../../scripts/element-review';
</script>

<style>
  .review {
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
    display: grid;
    gap: var(--space-7);
  }
  h1 {
    font-size: var(--step-3);
  }
  h2 {
    font-size: var(--step-2);
  }
  .intro {
    color: var(--ink-2);
    max-width: 70ch;
  }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: var(--step--1);
  }
  section {
    display: grid;
    gap: var(--space-4);
    scroll-margin-top: 5rem;
  }
  .secondary {
    opacity: 0.85;
  }
  .secondary summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .secondary summary::before {
    content: '▸';
    color: var(--ink-3, var(--ink-2));
    font-size: var(--step--1);
  }
  .secondary details[open] summary::before {
    content: '▾';
  }
  .secondary summary h2 {
    font-size: var(--step-1);
    color: var(--ink-2);
  }
  .secondary details > :not(summary) {
    margin-top: var(--space-4);
  }
  .cards {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
  }
  .cards.wide {
    grid-template-columns: 1fr;
    max-width: 60rem;
  }
  .card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .stage {
    background: #06070a;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.7rem;
  }
  .k {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: var(--step--1);
  }
  .t {
    font-weight: 600;
  }
  .btns {
    margin-left: auto;
    display: flex;
    gap: 0.35rem;
  }
  button {
    font: inherit;
    font-size: var(--step--2);
    font-family: var(--font-mono);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--ink);
    cursor: pointer;
  }
  button:hover,
  button[aria-pressed='true'] {
    border-color: var(--accent);
  }
  .note {
    color: var(--ink-2);
    font-size: var(--step--1);
    max-width: 70ch;
  }
  .frames,
  .stills {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .stills {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .frames figure,
  .stills figure {
    display: grid;
    gap: 0.3rem;
  }
  .frames canvas,
  .stills canvas {
    aspect-ratio: 16 / 10;
    height: auto;
    background: #06070a;
    border-radius: var(--radius);
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-2);
  }
  @media (max-width: 720px) {
    .frames,
    .stills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
