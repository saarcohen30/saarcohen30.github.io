---
// Hidden review: which visual system should the home page use? (noindex, not in the sitemap)
// Nothing here changes the live site; the normal rotation stays Adapt, Exchange, Share, Gather.
import Base from '../../layouts/Base.astro';
import ReviewCard from '../../components/review/ReviewCard.astro';
import { ENTRIES } from '../../lib/field/review/registry';
import { profile } from '../../lib/site';

const by = (id: string) => ENTRIES.find((e) => e.id === id)!;
const elements = ['water', 'air', 'earth', 'fire', 'convergence'].map(by);
const original = [
  { e: by('r-gather'), t: 'Coalitions & collective decisions' },
  { e: by('r-share'), t: 'Fair allocation over time' },
  { e: by('r-adapt'), t: 'Learning in multi-agent systems' },
  { e: by('r-exchange'), t: 'Principled & safe AI' },
];
const flowOnly = ['u-gather', 'u-share', 'u-adapt', 'u-exchange'].map(by);
const d2 = ['d2-gather', 'd2-share-a', 'd2-share-b', 'd2-adapt-a', 'd2-adapt-b', 'd2-exchange'].map(by);
// The preferred D2 study per theme, in the order of the home page's themes.
const preferred = ['d2-gather', 'd2-share-a', 'd2-adapt-a', 'd2-exchange'];
const themes = (profile.themes as { title: string; areas: string[]; summary: string }[]).map((t, i) => ({ ...t, e: by(preferred[i]) }));
---

<Base title="Scene architecture" description="Which visual system should the home page use?" noindex>
  <div class="wrap review arch">
    <p class="eyebrow">Design review · not linked from the site</p>
    <h1>Scene architecture</h1>

    <section id="hypothesis">
      <h2>Current hypothesis</h2>
      <div class="rec">
        <p><b>Elements = hero identity.</b> Water, Air, Earth, Fire and Convergence own the entrance: personality, atmosphere, memorability.</p>
        <p><b>Research-specific scenes = contextual explanation.</b> In “What I work on”, each theme gets a scene that shows its own mechanism: agents and groups, items and bundles, agents learning from feedback, attacker and defender.</p>
        <p><b>Shared art direction = coherence.</b> Same stage, pale marks, one warm accent, soft halos, hairlines and eased motion, not the same subject matter.</p>
      </div>
      <nav class="toc" aria-label="Sections">
        <a href="#elements">Elemental identity</a>
        <a href="#original">Original research scenes</a>
        <a href="#rejected">Rejected flow-only experiment</a>
        <a href="#d2">D2 studies</a>
        <a href="#mock">What I work on mock</a>
        <a href="#motion">Motion &amp; accessibility</a>
      </nav>
    </section>

    <section id="elements">
      <h2>Elemental identity</h2>
      <p class="intro">The hero family (production scenes, unchanged).</p>
      <div class="row five">{elements.map((e) => <ReviewCard e={e} compact />)}</div>
    </section>

    <section id="original">
      <h2>Original research scenes</h2>
      <p class="intro">Today’s hero rotation. Their mechanisms are the semantic foundation for D2; their node-and-edge style is what D2 brings into the shared art direction.</p>
      <div class="row four">
        {
          original.map((o) => (
            <div class="tile">
              <ReviewCard e={o.e} compact />
              <p>{o.t}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="rejected" class="rejected">
      <h2>Earlier flow-only experiment (rejected)</h2>
      <p class="flag">Rejected because semantic distinctions became too weak: all four read as variations of the Air scene.</p>
      <div class="row four">{flowOnly.map((e) => <ReviewCard e={e} compact />)}</div>
    </section>

    <section id="d2">
      <h2>D2: unified art direction, research-specific mechanisms</h2>
      <p class="intro">Semantic-design studies, not production. The labels under each card are for review only and would not appear on the site.</p>
      <div class="row two">
        {
          d2.map((e) => (
            <div class="d2">
              <ReviewCard e={e} compact />
              <dl class="sem">
                <dt>Intended reading</dt>
                <dd>{e.sem!.reading}</dd>
                <dt>Research connection</dt>
                <dd>{e.sem!.research}</dd>
                <dt>What is literal</dt>
                <dd>{e.sem!.literal}</dd>
                <dt>What is metaphorical</dt>
                <dd>{e.sem!.metaphor}</dd>
              </dl>
            </div>
          ))
        }
      </div>
    </section>

    <section id="mock">
      <h2>What I work on (mock)</h2>
      <p class="intro">The four preferred D2 studies (Share A, Adapt A) placed as they would appear in the real section, with its real text.</p>
      <div class="mock-work">
        <p class="mock-eyebrow"><span>02</span> Research</p>
        <p class="mock-h">What I work on</p>
        <ol class="mock-themes">
          {
            themes.map((t, i) => (
              <li>
                <ReviewCard e={t.e} compact />
                <p class="mock-n">{String(i + 1).padStart(2, '0')}</p>
                <h3>{t.title}</h3>
                <p class="mock-areas">{t.areas.join(' · ')}</p>
                <p class="mock-sum">{t.summary}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="motion">
      <h2>Motion &amp; accessibility (applies whichever option wins)</h2>
      <ul class="plain">
        <li>
          <b>WCAG 2.2.2 (Pause, Stop, Hide):</b> motion that starts automatically, lasts more than five seconds and runs alongside other content needs a way to pause, stop or hide it. The hero scenes move
          continuously today, and so would these illustrations: both need either a small pause control or motion that settles within five seconds.
        </li>
        <li><b>Reduced motion:</b> show a single representative still of each illustration (no animation code), as the hero already does.</li>
        <li><b>In context:</b> illustrations in “What I work on” should animate only while on screen, and more quietly than the hero.</li>
      </ul>
    </section>
  </div>
</Base>

<script>
  import '../../scripts/element-review';
</script>

<style is:global>
  .arch {
    padding-block: var(--space-7) var(--space-8);
    display: grid;
    gap: var(--space-7);
  }
  .arch h1 {
    font-size: var(--step-3);
  }
  .arch h2 {
    font-size: var(--step-2);
  }
  .arch h3 {
    font-size: var(--step-0);
    color: var(--ink-2);
  }
  .arch section {
    display: grid;
    gap: var(--space-4);
    scroll-margin-top: 5rem;
  }
  .arch .intro,
  .arch .dim {
    color: var(--ink-2);
    max-width: 72ch;
  }
  .arch .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: var(--step--1);
  }
  .arch .row {
    display: grid;
    gap: var(--space-3);
  }
  .arch .row.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .arch .row.five {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .arch .row.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .arch .rejected {
    opacity: 0.75;
  }
  .arch .flag {
    color: #d9895a;
    font-size: var(--step--1);
  }
  .arch .sem {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 0.8rem;
    font-size: var(--step--1);
    margin-top: 0.4rem;
  }
  .arch .sem dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3, var(--ink-2));
    padding-top: 0.15rem;
  }
  .arch .sem dd {
    color: var(--ink-2);
  }
  .arch .mock-work .ctl {
    display: none;
  }
  .arch .mock-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .arch .mock-eyebrow span {
    color: var(--accent);
    margin-right: 0.5em;
  }
  .arch .mock-themes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }
  .arch .mock-themes h3 {
    font-size: var(--step-0);
    color: var(--ink);
  }
  .arch .mock-n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--accent);
    margin-top: 0.6rem;
  }
  .arch .mock-areas {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-2);
  }
  .arch .mock-sum {
    font-size: var(--step--1);
    color: var(--ink-2);
    margin-top: 0.3rem;
  }
  .arch .card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .arch .stage {
    background: #06070a;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  .arch canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .arch .ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.6rem;
  }
  .arch .k {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: var(--step--1);
  }
  .arch .t {
    font-weight: 600;
    font-size: var(--step--1);
  }
  .arch .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    width: 100%;
  }
  .arch button {
    font: inherit;
    font-size: var(--step--2);
    font-family: var(--font-mono);
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--ink);
    cursor: pointer;
  }
  .arch .note {
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  /* Home-page mocks: the real stage colours and type, at reduced scale. */
  .arch .mock {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .arch .mock-hero {
    background:
      radial-gradient(ellipse 70% 60% at 72% 42%, rgba(80, 100, 170, 0.14), transparent 70%),
      #06070a;
    color: #eeebe4;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    min-height: 22rem;
  }
  .arch .mock-role {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a9adb6;
  }
  .arch .mock-name {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 330;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-block: 0.4rem 0.8rem;
  }
  .arch .mock-tag {
    color: #a9adb6;
    font-size: var(--step-0);
    max-width: 38ch;
  }
  .arch .mock-scene .stage {
    background: transparent;
  }
  .arch .mock .ctl {
    display: none;
  }
  .arch .mock-work {
    padding: var(--space-5);
    background: var(--bg);
    display: grid;
    gap: var(--space-3);
  }
  .arch .mock-h {
    font-size: var(--step-1);
  }
  .arch .tile p {
    font-size: var(--step--1);
    margin-top: 0.4rem;
  }
  .arch .rec {
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    max-width: 80ch;
  }
  .arch .rec ul,
  .arch .plain {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.2rem;
    max-width: 80ch;
  }
  .arch .rec li,
  .arch .plain li {
    list-style: disc;
  }
  @media (max-width: 900px) {
    .arch .row.four,
    .arch .row.five {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .arch .row.two,
    .arch .mock-themes {
      grid-template-columns: 1fr;
    }
  }
</style>
