---
import { isMe, type Publication } from '../../lib/site';
import AuthorNotes from './AuthorNotes.astro';

interface Props {
  pub: Publication;
  class?: string;
  /** Show the author note (e.g. equal contribution) under the names; off where the page places it itself. */
  notes?: boolean;
}
const { pub, class: className, notes = true } = Astro.props;
const n = pub.authors.length;
---

<p class:list={['authors', className]}>
  {
    pub.authors.map((a, i) => (
      <Fragment>
        {/* Name and symbol never separate across a line break. */}
        <span class="an">
          <span class:list={{ me: isMe(a.name) }}>{a.name}</span>
          {a.marks.length > 0 && (
            <sup class="mark" aria-hidden="true">
              {a.marks.join('')}
            </sup>
          )}
        </span>
        {i < n - 2 ? ', ' : i === n - 2 ? (n > 2 ? ', and ' : ' and ') : ''}
      </Fragment>
    ))
  }
  {notes && pub.authorNotes.length > 0 && <AuthorNotes pub={pub} class="below" />}
</p>

<style>
  .authors {
    color: var(--ink-2);
  }
  .an {
    white-space: nowrap;
  }
  .me {
    color: var(--ink);
    font-weight: 560;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }
  .mark {
    font-size: 0.72em;
    margin-left: 0.05em;
    color: var(--ink-2);
    font-weight: 400;
  }
  .authors :global(.author-note.below) {
    display: block;
    margin-top: 0.2em;
  }
</style>
