---
// Inline SVG icons. Line icons are original (24px grid, 1.6 stroke, currentColor).
// Brand marks: GitHub mark (permitted as a link to GitHub, unmodified, monochrome) and the
// official ORCID iD icon (unaltered). No venue or arXiv logos, for trademark reasons.
interface Props {
  name: string;
  size?: number | string;
  class?: string;
  label?: string;
}
const { name, size = '1em', class: className, label } = Astro.props;

