const f = fill[name];
const body = f ? f.body : stroke[name];
if (!body) throw new Error(`Icon "${name}" does not exist`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={f ? f.viewBox : '0 0 24 24'}
  width={size}
  height={size}
  fill="none"
  stroke={f ? undefined : 'currentColor'}
  stroke-width={f ? undefined : 1.6}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
