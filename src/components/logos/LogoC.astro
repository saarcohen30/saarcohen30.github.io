---
// Candidate C: typographic identity. Lowercase italic "sc" in the site serif, set in a rounded tile.
interface Props { size?: number; class?: string }
const { size = 32, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="30" height="30" rx="8" fill="currentColor" />
  <text x="16" y="21.6" text-anchor="middle" font-family="Newsreader, Georgia, serif" font-style="italic" font-size="19" font-weight="500" letter-spacing="-0.6" fill="var(--logo-on, var(--bg))">sc</text>
</svg>
