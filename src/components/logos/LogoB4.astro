---
// Flow & balance B4: S and C through flow. One stroke descends as an S and carries on into the
// lower arc of a C; the C's upper arc returns above it, like a current curling back.
interface Props { size?: number; class?: string }
const { size = 32, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <path d="M15.2 8.2C11.4 6 6.4 7.6 6.6 11.3C6.8 15 13.6 15.2 13.9 19.6C14.2 23.6 17.4 25.4 21 25.4C23.6 25.4 25.8 24.4 27.3 22.6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
  <path d="M27.3 9.4C25.9 7.7 23.8 6.6 21.6 6.6C20.4 6.6 19.4 6.9 18.6 7.4" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
</svg>
