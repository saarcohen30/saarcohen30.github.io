---
// Candidate A: minimal SC monogram. A narrow S and an open C on one baseline, drawn with the
// same geometric stroke, so the pair reads as initials rather than a symbol.
interface Props { size?: number; class?: string }
const { size = 32, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <path d="M13.2 10.2c-1-1.4-2.4-2-4-2-2.3 0-3.9 1.3-3.9 3.2 0 4.4 8.3 3.3 8.3 8.2 0 2.2-1.9 3.9-4.5 3.9-1.8 0-3.3-.8-4.3-2.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
  <path d="M27.4 11.2a7.1 7.1 0 1 0 0 9.6" stroke="var(--logo-accent, currentColor)" stroke-width="2.4" stroke-linecap="round" />
</svg>
