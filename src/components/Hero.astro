---
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { profile } from '../lib/site';
---

<section class="hero stage" data-stage-root aria-labelledby="hero-name">
  <canvas data-field aria-hidden="true"></canvas>

  <div class="inner wrap" data-hero-text>
    <p class="eyebrow role" data-seq="1">{profile.role} · {profile.affiliation_short}</p>
    <h1 id="hero-name" class="name">
      {
        profile.name.split(' ').map((word: string, i: number) => (
          <span class="word">
            <span style={`--w:${i}`}>{word}</span>
          </span>
        ))
      }
    </h1>
    <p class="tagline" data-seq="3">{profile.tagline}</p>
    <div class="cta" data-seq="4">
      <a class="btn btn--light" href="/publications/">
        Publications <Icon name="arrow-right" class="arrow" />
      </a>
      <a class="btn btn--ghost" href={profile.cv_pdf}>
        <Icon name="download" /> CV <span class="visually-hidden">(PDF)</span>
      </a>
      <a class="btn btn--ghost" href={`mailto:${profile.email}`}>
        <Icon name="mail" /> Email
      </a>
      <SocialLinks iconOnly class="hero-social" />
    </div>
  </div>

  <button class="skip mono" type="button" data-skip hidden>Skip intro <span aria-hidden="true">→</span></button>
  <button class="pause" type="button" data-motion-toggle hidden aria-pressed="false" aria-label="Pause animations">
    <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9M11 3.5v9" /></svg>
    <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5 12 8l-6.5 4.5z" /></svg>
  </button>
  <a class="cue mono" href="#about" aria-label="Scroll to About">
    <span class="cue-line" aria-hidden="true"><span></span></span>
  </a>
</section>

<script>
  // The hero scene (chosen in <head>). With reduced motion it is drawn once, settled.
  import('../scripts/hero');
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: max(34rem, 100svh);
    padding-top: var(--header-h);
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 60% at 72% 42%, rgba(80, 100, 170, 0.14), transparent 70%),
      var(--stage-bg);
    color: var(--stage-ink);
    color-scheme: dark;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
  }
  canvas {
    opacity: 0;
    transition: opacity 900ms ease;
  }
  :global(.js) .hero canvas:global(.ready) {
    opacity: 1;
  }
  .inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: var(--space-7) clamp(4.5rem, 11vh, 8rem);
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
    font-size: var(--step-4);
    font-weight: 330;
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 72;
    margin-block: var(--space-2) var(--space-1);
  }
  .word {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    padding-bottom: 0.08em;
  }
  .word > span {
    display: inline-block;
  }
  .role {
    color: var(--stage-ink-2);
  }
  .tagline {
    max-width: 38ch;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--stage-ink-2);
    font-weight: 380;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-4);
  }
  .btn--light {
    --btn-bg: var(--stage-ink);
    --btn-ink: var(--stage-bg);
    --btn-line: var(--stage-ink);
  }
  .btn--light:hover {
    --btn-bg: #fff;
  }
  .btn--ghost {
    --btn-ink: var(--stage-ink);
    --btn-line: rgba(238, 235, 228, 0.28);
  }
  .btn--ghost:hover {
    --btn-line: var(--stage-ink);
  }
  .cta :global(.hero-social) {
    margin-left: 0.25rem;
  }


  @media (min-width: 860px) {
    .hero {
      align-items: center;
    }
    .inner {
      grid-template-columns: minmax(0, 56%) 1fr;
      padding-block: var(--space-7);
    }
    .inner > * {
      grid-column: 1;
    }
    .name {
      flex-wrap: nowrap;
    }
  }
  /* Phones: the field occupies the upper part; keep the text block legible below it. */
  @media (max-width: 859px) {
    .hero {
      background:
        radial-gradient(ellipse 90% 45% at 50% 25%, rgba(80, 100, 170, 0.16), transparent 70%),
        var(--stage-bg);
    }
    /* Reserve the upper part of the stage for the field. */
    .inner {
      padding-top: clamp(12rem, 36svh, 20rem);
      padding-bottom: var(--space-7);
    }
  }

  .skip {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--header-h) + 0.75rem);
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: 999px;
    font-size: var(--step--2);
    color: var(--stage-ink-2);
    border: 1px solid var(--stage-line);
    background: rgba(6, 7, 10, 0.5);
    transition:
      color var(--dur-1),
      border-color var(--dur-1);
  }
  .skip:hover {
    color: var(--stage-ink);
    border-color: var(--stage-ink-2);
  }

  /* Pause / play all animations (WCAG 2.2.2). Quiet until hovered or focused. */
  .pause {
    position: absolute;
    right: var(--gutter);
    bottom: 1rem;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid transparent;
    background: none;
    color: var(--stage-ink-3);
    opacity: 0.55;
    cursor: pointer;
    transition:
      opacity var(--dur-1),
      border-color var(--dur-1),
      color var(--dur-1);
  }
  .pause[hidden] {
    display: none;
  }
  .pause:hover,
  .pause:focus-visible {
    opacity: 1;
    color: var(--stage-ink);
    border-color: var(--stage-line);
  }
  .pause svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pause .i-play {
    display: none;
  }
  .pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  .pause[aria-pressed='true'] .i-play {
    display: block;
  }
  .cue {
    position: absolute;
    left: 50%;
    bottom: 0.75rem;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 56px;
    color: var(--stage-ink-3);
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 36px;
    background: var(--stage-line);
    overflow: hidden;
  }
  .cue-line span {
    position: absolute;
    left: -2px;
    bottom: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--stage-ink-2);
  }
  @media (max-width: 859px) {
    .cue {
      display: none;
    }
  }

  /* ---------------- The entrance sequence (first visit only; `intro` is set in <head>). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.intro) .hero [data-seq] {
      animation: seq-in 1100ms var(--ease-out) both;
      animation-delay: calc(var(--d, 0) * 1ms);
    }
    :global(.intro) .role {
      --d: 350;
    }
    :global(.intro) .tagline {
      --d: 1250;
    }
    :global(.intro) .cta {
      --d: 1600;
    }
    :global(.intro) .word > span {
      animation: word-rise 1300ms var(--ease-out) both;
      animation-delay: calc(500ms + var(--w) * 140ms);
    }
    :global(.intro) :global(.site-header) {
      animation: seq-in 900ms var(--ease-out) 1800ms both;
    }
    :global(.intro-skip) .hero *,
    :global(.intro-skip) :global(.site-header) {
      animation: none !important;
    }
    /* Scroll-linked: the hero content drifts up and fades as you leave it. */
    @supports (animation-timeline: view()) {
      canvas {
        animation: field-exit linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes seq-in {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(6px);
    }
  }
  @keyframes word-rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes field-exit {
    to {
      opacity: 0.25;
    }
  }
</style>
